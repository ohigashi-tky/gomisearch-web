{
  "name": "@gomisearch/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../web/dist && wrangler dev",
    "deploy": "wrangler deploy",
    "test": "mkdir -p ../web/dist && vitest run",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "db:migrate:local": "wrangler d1 migrations apply gomisearch-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply gomisearch-db --remote"
  },
  "dependencies": {
    "@gomisearch/schema": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.7.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.0",
    "@cloudflare/workers-types": "^4.20250620.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.20.0"
  }
}
